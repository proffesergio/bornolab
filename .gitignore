# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# runtime data (local analytics, dashboard edits) — never commit
data/*.json

# admin-uploaded catalog files — local/self-host content, never commit
/public/uploads/*
!/public/uploads/.gitkeep

# vercel
.vercel

# graphify knowledge-graph cache — local only, excluded from deploys too
graphify-out/

# typescript
*.tsbuildinfo
next-env.d.ts
