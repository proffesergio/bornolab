# BornoLab — environment template.
# Copy to .env.local for local dev:  Copy-Item .env.example .env.local
# On Vercel: add each var via `vercel env add <NAME> production` (see docs/deploy-vercel.md).
# This file is committed; .env.local is git-ignored — never put real secrets here.

# --- Admin (required for /admin — see docs/admin.md) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-to-a-long-random-password
# Recommended: any long random string. Rotating it invalidates all admin sessions.
ADMIN_JWT_SECRET=change-me-to-a-long-random-string-min-32-chars
# Optional member-session secret (falls back to ADMIN_JWT_SECRET when unset).
# USER_JWT_SECRET=

# Public site URL (metadata canonical + sitemap). No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- n8n automation (optional; blank = graceful mock/fallback in the UI) ---
# N8N_FORMAT_WEBHOOK_URL=
# N8N_TRANSLATE_WEBHOOK_URL=
# N8N_SPLIT_WEBHOOK_URL=
# N8N_API_KEY=

# --- Member OAuth (optional; blank = provider button disabled gracefully) ---
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=
# Dev email codes need no mailer: without SMTP_HOST the code is returned in the
# API response so you can log in locally (see src/app/api/auth/request-code/route.ts).

# --- Durable site-config seed (recommended on Vercel — see docs/admin.md §3) ---
# Dashboard edits are ephemeral on serverless; bake anything worth keeping here.
# SITE_CONFIG_JSON={"seo":{"gaId":"G-XXXXXXX","adsenseClient":"ca-pub-XXXX"},"payments":{"bkash":"01XXXXXXXXX"}}
